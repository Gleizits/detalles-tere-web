<?xml version="1.0" encoding="UTF-8"?>
<!--
  Contexto de la aplicación DetallesTereWeb.
  Variante DESARROLLO local: NetBeans -> XAMPP Tomcat 8.5 (C:\xampp\tomcat)
  con SQL Server 2019 Developer Edition en localhost:1433.

  Define DB_URL, DB_USER y DB_PASSWORD como propiedades del proceso de
  Tomcat antes de desplegar. DB_URL debe usar un certificado confiable;
  nunca guardes conexión ni credenciales en este archivo.
-->
<Context path="/DetallesTereWeb">

    <!-- DataSource JNDI. El driver mssql-jdbc debe estar en la lib
         compartida del Tomcat (lib/), no solo en WEB-INF/lib. -->
    <Resource name="jdbc/DetallesTere"
              auth="Container"
              type="javax.sql.DataSource"
              driverClassName="com.microsoft.sqlserver.jdbc.SQLServerDriver"
              url="${DB_URL}"
              username="${DB_USER}"
              password="${DB_PASSWORD}"
              maxTotal="20"
              maxIdle="5"
              minIdle="2"
              maxWaitMillis="10000"
              validationQuery="SELECT 1"
              testOnBorrow="true"/>

</Context>
