<?xml version="1.0" encoding="UTF-8"?>
<!--
  Contexto de la aplicación DetallesTereWeb.
  Variante DESARROLLO local: NetBeans -> XAMPP Tomcat 8.5 (C:\xampp\tomcat)
  con SQL Server 2019 Developer Edition en localhost:1433 (TCP/IP activado,
  modo de autenticación Mixto, login sa con contraseña 191224).

  Para desplegar en un contenedor usa setup/context-contenedor.xml
  (URL jdbc:sqlserver://DetallesTereDB:1433).
-->
<Context path="/DetallesTereWeb">

    <!-- DataSource JNDI. El driver mssql-jdbc debe estar en la lib
         compartida del Tomcat (lib/), no solo en WEB-INF/lib. -->
    <Resource name="jdbc/DetallesTere"
              auth="Container"
              type="javax.sql.DataSource"
              driverClassName="com.microsoft.sqlserver.jdbc.SQLServerDriver"
              url="jdbc:sqlserver://localhost:1433;databaseName=DetallesTereDB;encrypt=true;trustServerCertificate=true"
              username="sa"
              password="191224"
              maxTotal="20"
              maxIdle="5"
              minIdle="2"
              maxWaitMillis="10000"
              validationQuery="SELECT 1"
              testOnBorrow="true"/>

</Context>
