<?xml version="1.0" encoding="UTF-8"?>
<!--
  Variante CONTENEDOR del contexto de DetallesTereWeb.
  SQL Server se resuelve como DetallesTereDB dentro de la red Podman.

  Uso:
   1) Copia el driver al contenedor Tomcat (una vez por recreación):
        podman cp web/WEB-INF/lib/mssql-jdbc-12.8.1.jre11.jar \
          DetallesTereTomcat:/usr/local/tomcat/lib/
      y reinicia: podman restart DetallesTereTomcat
   2) Copia este archivo al contenedor:
        podman cp setup/context-contenedor.xml \
          DetallesTereTomcat:/usr/local/tomcat/conf/Catalina/localhost/DetallesTereWeb.xml
   3) Despliega el WAR en /usr/local/tomcat/webapps/.
-->
<Context path="/DetallesTereWeb">

    <Resource name="jdbc/DetallesTere"
              auth="Container"
              type="javax.sql.DataSource"
              driverClassName="com.microsoft.sqlserver.jdbc.SQLServerDriver"
              url="${DB_URL}"
              username="${DB_USER}"
              password="${DB_PASSWORD}"
              maxTotal="20"
              maxIdle="5"
              minIdle="2"
              maxWaitMillis="10000"
              validationQuery="SELECT 1"
              testOnBorrow="true"/>

</Context>
