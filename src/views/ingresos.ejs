<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <h1 class="titulo-seccion mb-0">
        <i class="bi bi-truck me-2" aria-hidden="true"></i>Ingresos
    </h1>
    <a class="btn btn-outline-secondary" href="<%= e(url('/panel')) %>">
        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Inicio
    </a>
</div>

<% if (error) { %>
    <div class="alerta-error mb-4" role="alert">
        <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i><%= e(error) %>
    </div>
<% } %>

<div class="row g-4">
    <div class="col-12 col-xl-8">
        <div class="app-card p-4">
            <h2 class="h4 mb-3">Registrar entrada de mercadería</h2>
            <form method="post" action="<%= e(url('/ingresos')) %>">
                <input type="hidden" name="csrfToken" value="<%= e(csrfToken) %>">
                <input type="hidden" name="accion" value="registrar">
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-7">
                        <label class="form-label" for="idProveedor">Proveedor *</label>
                        <select class="form-select" id="idProveedor" name="idProveedor" required>
                            <option value="">— Selecciona un proveedor —</option>
                            <% for (const p of proveedores) { %>
                                <option value="<%= p.idProveedor %>">
                                    <%= e(p.nombre) %> · <%= e(p.numero) %>
                                </option>
                            <% } %>
                        </select>
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label" for="fechaIngreso">Fecha *</label>
                        <input class="form-control" type="date" id="fechaIngreso"
                               name="fechaIngreso" value="<%= e(fechaActual) %>" required>
                    </div>
                </div>

                <p class="form-label mb-2">Artículos recibidos</p>
                <div id="lineasIngreso">
                    <% for (let i = 0; i < 6; i++) { %>
                        <div class="row g-2 align-items-end mb-2 linea-ingreso">
                            <div class="col-12 col-md-5">
                                <label class="visually-hidden" for="articulo<%= i %>">Artículo</label>
                                <select class="form-select" id="articulo<%= i %>" name="idInventario[]">
                                    <option value="">— Artículo —</option>
                                    <% for (const it of inventario) { %>
                                        <option value="<%= it.idInventario %>">
                                            <%= e(it.nombre) %> · <%= e(it.clase) %>
                                        </option>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-4 col-md-2">
                                <label class="visually-hidden" for="cantidad<%= i %>">Cantidad</label>
                                <input class="form-control" type="number" id="cantidad<%= i %>"
                                       name="cantidad[]" min="1" step="1" placeholder="Cantidad">
                            </div>
                            <div class="col-4 col-md-2">
                                <label class="visually-hidden" for="costo<%= i %>">Precio de compra</label>
                                <input class="form-control" type="text" id="costo<%= i %>"
                                       name="precioCompra[]" inputmode="decimal" placeholder="Costo S/">
                            </div>
                            <div class="col-4 col-md-3">
                                <label class="visually-hidden" for="obs<%= i %>">Observaciones</label>
                                <input class="form-control" type="text" id="obs<%= i %>"
                                       name="observaciones[]" maxlength="100" placeholder="Observación">
                            </div>
                        </div>
                    <% } %>
                </div>
                <small class="text-muted d-block mb-3">
                    Las filas vacías se ignoran. El costo registrado reemplaza el costo vigente del artículo.
                </small>
                <button class="btn btn-app btn-app-primary" type="submit">
                    <i class="bi bi-box-arrow-in-down me-1" aria-hidden="true"></i>Registrar ingreso
                </button>
            </form>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="app-card p-4 mb-4">
            <h2 class="h4 mb-3">Nuevo proveedor</h2>
            <form method="post" action="<%= e(url('/ingresos')) %>">
                <input type="hidden" name="csrfToken" value="<%= e(csrfToken) %>">
                <input type="hidden" name="accion" value="crearProveedor">
                <div class="mb-3">
                    <label class="form-label" for="nombreProveedor">Nombre *</label>
                    <input class="form-control" id="nombreProveedor" name="nombreProveedor"
                           maxlength="50" required>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="numeroProveedor">Número *</label>
                    <input class="form-control" id="numeroProveedor" name="numeroProveedor"
                           maxlength="12" required>
                </div>
                <button class="btn btn-outline-primary" type="submit">
                    <i class="bi bi-person-plus me-1" aria-hidden="true"></i>Guardar proveedor
                </button>
            </form>
        </div>

        <div class="app-card p-4">
            <h2 class="h4 mb-3">Últimos ingresos</h2>
            <% if (ingresos.length === 0) { %>
                <p class="text-muted mb-0">Todavía no hay ingresos registrados.</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="tabla-app">
                        <thead>
                            <tr><th>Proveedor · artículo</th><th>Cant.</th><th>Total</th></tr>
                        </thead>
                        <tbody>
                            <% for (const linea of ingresos) { %>
                                <tr>
                                    <td><%= e(linea.nombre ?? linea.nombreProveedor ?? '') %></td>
                                    <td><%= linea.cantidad ?? 0 %></td>
                                    <td>S/ <%= e(num(linea.subtotal ?? 0)) %></td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
</div>
