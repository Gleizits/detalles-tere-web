<% /** Formulario de nuevo pedido reservado (solo contenido de <main>). */ %>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <h1 class="titulo-seccion mb-0">
        <i class="bi bi-calendar2-plus me-2" aria-hidden="true"></i>Nuevo pedido reservado
    </h1>
    <a class="btn btn-outline-secondary" href="<%= e(url('/pedidos')) %>">
        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Volver
    </a>
</div>

<% if (caja === null) { %>
    <div class="alerta-error mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span>
            <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
            No tienes la caja abierta. Ábrela para cobrar el adelanto.
        </span>
        <a class="btn btn-app btn-app-primary" href="<%= e(url('/caja')) %>">Ir a Caja</a>
    </div>
<% } %>

<div class="venta-grid">

    <!-- ===================== CATÁLOGO ===================== -->
    <div class="app-card p-3">
        <h2 class="titulo-seccion mb-3" style="font-size:1.25rem">Agregar productos</h2>

        <form action="<%= e(url('/pedidos')) %>" method="get" class="mb-3" role="search">
            <input type="hidden" name="nuevo" value="1">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input type="search" class="form-control" name="q" value="<%= e(q) %>"
                       placeholder="Buscar producto o término…" aria-label="Buscar productos">
                <button class="btn btn-app btn-app-primary" type="submit">Buscar</button>
            </div>
        </form>

        <% if (items.length === 0) { %>
            <p class="text-muted mb-0">Sin resultados en el inventario.</p>
        <% } else { %>
            <div class="tabla-envoltorio">
                <table class="tabla-app">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="num">P. venta</th>
                            <th class="num">Stock</th>
                            <th>Agregar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (const it of items) { %>
                            <% const sinPrecio = it.precioVenta === null; %>
                            <tr>
                                <td class="nombre-item"><%= e(it.nombre) %></td>
                                <td class="num">
                                    <% if (!sinPrecio) { %>
                                        S/ <%= num(it.precioVenta) %>
                                    <% } else { %>
                                        —
                                    <% } %>
                                </td>
                                <td class="num">
                                    <% if (it.esStockBajo()) { %>
                                        <span class="badge-estado bajo"><%= Number(it.stockAct) %></span>
                                    <% } else { %>
                                        <%= Number(it.stockAct) %>
                                    <% } %>
                                </td>
                                <td>
                                    <form class="catalogo-form" method="post" action="<%= e(url('/pedidos')) %>">
                                        <input type="hidden" name="csrfToken" value="<%= e(csrfToken) %>">
                                        <input type="hidden" name="accion" value="agregar">
                                        <input type="hidden" name="idInventario" value="<%= Number(it.idInventario) %>">
                                        <input type="number" class="form-control cant-input"
                                               name="cantidad" value="1" min="1"
                                               <%- it.stockAct > 0 ? 'max="' + Number(it.stockAct) + '"' : '' %>
                                               aria-label="Cantidad">
                                        <button class="btn btn-app btn-app-primary btn-sm" type="submit"
                                                <%= (it.stockAct <= 0 || sinPrecio) ? 'disabled' : '' %>>
                                            Agregar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <%- include('comunes/paginacion', {
                paginacion,
                base: '/pedidos',
                filtros: { q, nuevo: 1 },
                etiqueta: 'artículos'
            }) %>
        <% } %>
    </div>

    <!-- ===================== CARRITO ===================== -->
    <div class="app-card p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="titulo-seccion mb-0" style="font-size:1.25rem">Carrito de la reserva</h2>
            <% if (carrito.length > 0) { %>
                <form method="post" action="<%= e(url('/pedidos')) %>">
                    <input type="hidden" name="csrfToken" value="<%= e(csrfToken) %>">
                    <input type="hidden" name="accion" value="vaciar">
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash me-1" aria-hidden="true"></i>Vaciar
                    </button>
                </form>
            <% } %>
        </div>

        <% if (carrito.length === 0) { %>
            <p class="text-muted mb-0">El carrito está vacío. Agrega productos desde el catálogo.</p>
        <% } else { %>
            <div class="tabla-envoltorio">
                <table class="tabla-app">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="num">Cant.</th>
                            <th class="num">Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% carrito.forEach((linea, indice) => { %>
                            <tr>
                                <td><%= e(linea.nombre) %></td>
                                <td class="num"><%= Number(linea.cantidad) %></td>
                                <td class="num">S/ <%= num(linea.subtotal) %></td>
                                <td class="text-end">
                                    <form method="post" action="<%= e(url('/pedidos')) %>">
                                        <input type="hidden" name="csrfToken" value="<%= e(csrfToken) %>">
                                        <input type="hidden" name="accion" value="eliminar">
                                        <input type="hidden" name="indice" value="<%= Number(indice) %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                title="Quitar del carrito" aria-label="Quitar del carrito">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <div class="carrito-total">
                <span class="etq">Total</span>
                <span class="val">S/ <%= num(totalCarrito) %></span>
            </div>
        <% } %>
    </div>
</div>

<!-- ===================== DATOS DEL CLIENTE Y PAGO ===================== -->
<% if (carrito.length > 0) { %>
    <div class="app-card p-4 mt-4">
        <h2 class="titulo-seccion mb-3" style="font-size:1.25rem">
            <i class="bi bi-person-vcard me-2" aria-hidden="true"></i>Datos del cliente y pago
        </h2>

        <form method="post" action="<%= e(url('/pedidos')) %>" autocomplete="off"
              data-total="<%= e(numJs(totalCarrito)) %>">
            <input type="hidden" name="csrfToken" value="<%= e(csrfToken) %>">
            <input type="hidden" name="accion" value="crear">

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <label class="form-label" for="celular">Celular del cliente *</label>
                    <input type="tel" class="form-control" id="celular" name="celular"
                           required maxlength="12" placeholder="Ej: 987654321">
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label" for="nombrePaga">Nombre de quien paga *</label>
                    <input type="text" class="form-control" id="nombrePaga" name="nombrePaga"
                           required maxlength="90" placeholder="Ej: María López">
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label" for="nombreRecoge">Nombre de quien recoge</label>
                    <input type="text" class="form-control" id="nombreRecoge" name="nombreRecoge"
                           maxlength="90" placeholder="Opcional">
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="fechaRecojo">Día de recojo *</label>
                    <input type="date" class="form-control" id="fechaRecojo" name="fechaRecojo"
                           required min="<%= e(hoy) %>" value="<%= e(hoy) %>">
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="horaRecojo">Hora</label>
                    <input type="time" class="form-control" id="horaRecojo" name="horaRecojo">
                </div>
            </div>

            <div class="pago-zona">
                <div class="row g-4">
                    <!-- Tipo de reserva -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-bold">¿Cuánto se paga ahora?</label>
                        <div class="d-flex flex-column gap-2 mt-1">
                            <div class="form-check fs-5">
                                <input class="form-check-input" type="radio" name="tipoReserva"
                                       id="tipoAdelanto" value="adelanto" checked>
                                <label class="form-check-label" for="tipoAdelanto">
                                    A cuenta / adelanto (mínimo 50%)
                                </label>
                            </div>
                            <div class="form-check fs-5">
                                <input class="form-check-input" type="radio" name="tipoReserva"
                                       id="tipoCompleto" value="completo">
                                <label class="form-check-label" for="tipoCompleto">
                                    Pago completo
                                </label>
                            </div>
                        </div>

                        <div id="zonaAdelanto" class="mt-3">
                            <label class="form-label" for="monto">Monto a pagar ahora (S/)</label>
                            <input type="number" step="0.01" min="0" max="<%= e(numJs(totalCarrito)) %>"
                                   inputmode="decimal" class="form-control" name="monto" id="monto">
                            <small class="text-muted" id="minNota"></small>
                        </div>
                        <div id="zonaCompleto" class="mt-3 alerta-info" style="display:none">
                            Se cobra el total: S/ <span id="totalCompleto"></span>
                        </div>
                    </div>

                    <!-- Método de pago -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-bold">Método de pago</label>
                        <div class="d-flex gap-4 mt-1">
                            <div class="form-check fs-5">
                                <input class="form-check-input" type="radio" name="metodo"
                                       id="mEfectivo" value="EFECTIVO" checked>
                                <label class="form-check-label" for="mEfectivo">
                                    <i class="bi bi-cash me-1" aria-hidden="true"></i>Efectivo
                                </label>
                            </div>
                            <div class="form-check fs-5">
                                <input class="form-check-input" type="radio" name="metodo"
                                       id="mYape" value="YAPE">
                                <label class="form-check-label" for="mYape">
                                    <i class="bi bi-phone me-1" aria-hidden="true"></i>Yape
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-app btn-app-primary w-100 py-2 mt-4"
                        <%= caja === null ? 'disabled' : '' %>>
                    <i class="bi bi-calendar2-check me-1" aria-hidden="true"></i>
                    Reservar pedido (apartar stock)
                </button>
                <p class="text-muted text-center mt-2 mb-0">
                    Al reservar se aparta el stock y el pago entra a la caja.
                </p>
            </div>
        </form>
    </div>
<% } %>

<script src="<%= e(url('/assets/js/pedido-form.js')) %>"></script>
