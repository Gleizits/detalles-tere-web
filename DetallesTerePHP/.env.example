# =============================================================
# DetallesTere — variables de entorno
# Copia este archivo a .env y ajusta los valores.
# .env NUNCA se versiona (ver .gitignore).
# =============================================================

# --- Base de datos -------------------------------------------------
# SQL Server 2019 Developer Edition, base DetallesTereDB (la misma
# que usaba el proyecto Java).
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=DetallesTereDB
# true en local si SQL Server acepta la identidad de Windows (sin UID/PWD).
DB_WINDOWS_AUTH=false
DB_USER=sa
DB_PASSWORD=TuPasswordSeguro123

# true si el servidor usa certificado autofirmado (típico en local).
DB_TRUST_CERT=true

# Segundos de espera antes de cortar una conexión colgada.
DB_TIMEOUT=10

# --- Aplicación ----------------------------------------------------
# Minutos de inactividad antes de cerrar la sesión.
SESSION_MINUTES=30

# Minutos entre limpiezas oportunistas de cotizaciones vencidas.
CLEANUP_MINUTES=15

# Zona horaria.
APP_TIMEZONE=America/Lima

# true en producción con HTTPS: marca la cookie de sesión como Secure.
COOKIE_SECURE=false

# true en producción: no volcar trazas en pantalla.
APP_PRODUCTION=false
