# ------------------------------------------------------------
# DetallesTere — Apache (XAMPP / Render con contenedor Apache)
# DocumentRoot debe apuntar a la carpeta public/
# ------------------------------------------------------------

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # La base URL se calcula en PHP; aquí solo se reescribe a index.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Cabeceras de seguridad como red de seguridad (PHP también las envía).
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Bloquea el acceso a archivos de configuración si el docroot se
# llegara a apuntar por error a la raíz del proyecto.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
