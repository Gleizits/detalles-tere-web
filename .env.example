# DetallesTereTS — variables de entorno para la versión Node/TypeScript
# Copia a .env para desarrollo local. En Vercel configura estas mismas
# variables en Project Settings → Environment Variables.

# SQL Server (la misma base DetallesTereDB que usaba la versión PHP/Java)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=DetallesTereDB
DB_USER=sa
DB_PASSWORD=TuPasswordSeguro123
DB_TRUST_CERT=true
DB_TIMEOUT=10
# DB_WINDOWS_AUTH=true
# DB_DOMAIN=TU_DOMINIO
DB_ENCRYPT=false

# Sesión firmada (OBLIGATORIA en producción: usa un valor largo y aleatorio)
SESSION_SECRET=cambia-este-secreto-por-uno-muy-largo-y-aleatorio
SESSION_MINUTES=30
COOKIE_SECURE=false
BASE_URL=

APP_TIMEZONE=America/Lima
APP_PRODUCTION=false

# ------------------------------------------------------------------
# Contacto de la portada pública
# Completa SOLO con datos reales. Si no tienes el dato, deja la variable
# vacía: la portada no muestra enlaces inventados.
# ------------------------------------------------------------------
# Correo que recibe los mensajes del formulario.
CONTACT_EMAIL=correo-real@ejemplo.com
# Remitente verificado en Resend (obligatorio para enviar desde el servidor).
CONTACT_EMAIL_FROM=DetallesTereTS <onboarding@resend.dev>
# Si se deja vacío, el formulario ofrece abrir el cliente de correo (mailto:).
RESEND_API_KEY=
# Número real de WhatsApp en formato internacional, solo dígitos (ej. 519...)
# Vacío = botón genérico wa.me para compartir, sin número inventado.
WHATSAPP_NUMBER=
# URL del iframe del mapa. El valor por defecto muestra Ica, Perú sin inventar dirección.
MAPS_EMBED_SRC=https://www.google.com/maps?q=Ica%2C%20Peru&output=embed
# Enlaces reales de redes sociales; vacíos = no se muestran.
FACEBOOK_URL=
INSTAGRAM_URL=
TIKTOK_URL=
